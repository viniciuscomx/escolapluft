{
  "name": "EnrollmentRequest",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string",
      "description": "Nome da crian\u00e7a"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento da crian\u00e7a"
    },
    "stage": {
      "type": "string",
      "enum": [
        "Ber\u00e7\u00e1rio",
        "Educa\u00e7\u00e3o Infantil",
        "Ainda n\u00e3o sei"
      ],
      "default": "Ber\u00e7\u00e1rio",
      "description": "Etapa de interesse"
    },
    "guardian_name": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "description": "Telefone ou WhatsApp de contato"
    },
    "message": {
      "type": "string",
      "description": "Mensagem livre do respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "em contato",
        "matriculado",
        "arquivado"
      ],
      "default": "novo"
    }
  },
  "required": [
    "student_name",
    "guardian_name",
    "email",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}